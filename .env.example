# Ezco - Environment Configuration Template
# Copy this file to .env.local and fill in your values

# ==================== Blockchain Configuration ====================

# RPC Endpoints
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
VITE_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
VITE_POLYGON_RPC_URL=https://polygon-rpc.com
VITE_BASE_RPC_URL=https://mainnet.base.org

# Default Network Configuration
VITE_CHAIN_ID=11155111  # Sepolia testnet
VITE_NETWORK_NAME=sepolia

# ==================== Smart Contract Addresses ====================

# RealEstateTrust Contract
VITE_REAL_ESTATE_TRUST_ADDRESS=0x

# ERC-20 Token Addresses (Sepolia)
VITE_USDC_ADDRESS=0x
VITE_USDT_ADDRESS=0x
VITE_DAI_ADDRESS=0x

# ==================== Frontend Configuration ====================

# API Base URL
VITE_API_BASE_URL=http://localhost:3000

# Pinata Configuration (for NFT metadata and images)
VITE_PINATA_API_KEY=
VITE_PINATA_API_SECRET=

# ==================== Analytics & Monitoring ====================

# Sentry Error Tracking (optional)
VITE_SENTRY_DSN=

# Google Analytics (optional)
VITE_GA_ID=

# ==================== Deployment Configuration ====================

# Private Key for deployments (NEVER commit this!)
# Use: export PRIVATE_KEY=your_key before running deploy scripts
# PRIVATE_KEY=

# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=

# ==================== Development ====================

# Development server port
VITE_PORT=5173

# Enable debug logging
VITE_DEBUG=false

# GraphQL Endpoint (if using The Graph)
VITE_SUBGRAPH_URL=
