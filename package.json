{
  "name": "ezco",
  "version": "1.0.0",
  "description": "A decentralized real estate trust platform for Nigerians in diaspora",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "test:watch": "hardhat test --watch",
    "compile": "hardhat compile",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network ethereum",
    "node": "hardhat node",
    "coverage": "hardhat coverage",
    "verify": "hardhat verify",
    "client:install": "cd client && npm install",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "client:preview": "cd client && npm run preview",
    "client:lint": "cd client && npm run lint",
    "setup": "npm install && npm run client:install && echo 'Setup complete! Copy .env.example to .env.local and fill in your values.'",
    "dev": "concurrently \"npm run node\" \"npm run client:dev\"",
    "lint": "hardhat compile",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,sol}\""
  },
  "keywords": [
    "ethereum",
    "blockchain",
    "real-estate",
    "dapp",
    "web3",
    "smart-contracts"
  ],
  "author": "Ezco Team",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@nomicfoundation/edr": "^0.20.0",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "ethers": "^6.17.0",
    "hardhat": "^3.15.0",
    "hardhat-ethers": "^1.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "viem": "^2.56.3"
  }
}
